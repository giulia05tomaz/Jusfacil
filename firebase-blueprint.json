{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile data for citizens, lawyers, and admins.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "role": { "type": "string", "enum": ["CITIZEN", "LAWYER", "ADMIN"] },
        "cpf": { "type": "string", "maxLength": 20 },
        "phone": { "type": "string", "maxLength": 25 },
        "username": { "type": "string", "maxLength": 50 },
        "oabNumber": { "type": "string", "maxLength": 30 },
        "oabState": { "type": "string", "maxLength": 2 },
        "lawyerStatus": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "role"]
    },
    "LegalCase": {
      "title": "Legal Case",
      "description": "Legal case record managed by JusFácil and JurisBot.",
      "type": "object",
      "properties": {
        "caseId": { "type": "string" },
        "citizenId": { "type": "string" },
        "assignedLawyerId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "summary": { "type": "string", "maxLength": 2000 },
        "originalStory": { "type": "string", "maxLength": 10000 },
        "status": {
          "type": "string",
          "enum": [
            "TRIAGEM",
            "COLETANDO_INFORMACOES",
            "AGUARDANDO_INFORMACOES",
            "COLETANDO_EVIDENCIAS",
            "ANALISANDO",
            "NECESSITA_ESCLARECIMENTO",
            "PREPARANDO_MINUTA",
            "AGUARDANDO_REVISAO",
            "AJUSTANDO_MINUTA",
            "MINUTA_APROVADA",
            "REVISAO_HUMANA",
            "ENCAMINHADO_ADVOGADO",
            "PRONTO_PARA_PROTOCOLO",
            "EM_ANDAMENTO",
            "CONCLUIDO"
          ]
        },
        "requiresHumanReview": { "type": "boolean" },
        "humanReviewReason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["caseId", "citizenId", "title", "status"]
    },
    "CaseMessage": {
      "title": "Case Message",
      "description": "Chat message in JurisBot conversation.",
      "type": "object",
      "properties": {
        "messageId": { "type": "string" },
        "caseId": { "type": "string" },
        "sender": { "type": "string", "enum": ["USER", "BOT", "LAWYER", "SYSTEM"] },
        "senderName": { "type": "string", "maxLength": 100 },
        "content": { "type": "string", "maxLength": 5000 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["messageId", "caseId", "sender", "content"]
    },
    "DraftVersion": {
      "title": "Draft Version",
      "description": "Versioned legal document draft generated by JurisBot.",
      "type": "object",
      "properties": {
        "version": { "type": "number" },
        "caseId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 20000 },
        "approved": { "type": "boolean" },
        "feedback": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["version", "caseId", "content"]
    },
    "Evidence": {
      "title": "Evidence Document",
      "description": "Evidence file associated with a legal case.",
      "type": "object",
      "properties": {
        "evidenceId": { "type": "string" },
        "caseId": { "type": "string" },
        "fileName": { "type": "string", "maxLength": 255 },
        "fileType": { "type": "string", "maxLength": 100 },
        "fileSize": { "type": "number" },
        "fileUrl": { "type": "string" },
        "description": { "type": "string", "maxLength": 500 },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["evidenceId", "caseId", "fileName"]
    },
    "NotificationItem": {
      "title": "Notification Item",
      "description": "User notification regarding case updates.",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string" },
        "userId": { "type": "string" },
        "caseId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["notificationId", "userId", "title", "message"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User accounts and profile information."
    },
    "/cases/{caseId}": {
      "schema": { "$ref": "#/entities/LegalCase" },
      "description": "Legal cases created by citizens or assigned to lawyers."
    },
    "/cases/{caseId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/CaseMessage" },
      "description": "Messages exchanged within a case."
    },
    "/cases/{caseId}/drafts/{draftId}": {
      "schema": { "$ref": "#/entities/DraftVersion" },
      "description": "Legal document draft versions."
    },
    "/cases/{caseId}/evidences/{evidenceId}": {
      "schema": { "$ref": "#/entities/Evidence" },
      "description": "Uploaded case evidence."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Notifications for users."
    }
  }
}
